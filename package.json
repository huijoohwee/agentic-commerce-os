{
  "name": "agentic-commerce-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "sharp": "0.35.4"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:apex": "node scripts/dev.ts --port 5173",
    "dev:offline": "vitest --config vitest.worker.config.ts",
    "types": "wrangler types -c wrangler.core.jsonc --env dev --env-file config/core-types.env --strict-vars=false --include-runtime=false --env-interface CoreEnv src/generated/core-env.d.ts && wrangler types -c wrangler.edge.jsonc --env dev --env-file .dev.vars.example --strict-vars=false --include-runtime=false --env-interface EdgeEnv src/generated/edge-env.d.ts",
    "types:check": "npm run types && git diff --exit-code -- src/generated",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:domain && npm run test:unit",
    "test:domain": "node --test test/domain/*.test.ts test/domain/*.test.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:workers": "vitest run --config vitest.worker.config.ts",
    "test:browser": "node scripts/checks/browser.ts",
    "test:e2e:dev": "node scripts/checks/browser.ts --dev-only",
    "deploy:dev:dry": "node scripts/dry-deploy-controller.ts",
    "bundle:production": "node scripts/checks/bundle-size.ts",
    "deploy:production:dry": "node scripts/release-controller.ts guard --target=delivery-route --dry-run && npm run bundle:production",
    "deploy:production:core": "node scripts/release-controller.ts guard --target=delivery-route",
    "deploy:production:edge": "node scripts/release-controller.ts guard --target=delivery-route",
    "check:terminology": "node scripts/checks/terminology.ts",
    "check:convergence": "node scripts/checks/convergence.ts",
    "check:take-rate": "node scripts/checks/take-rate.ts",
    "check:template-pack": "node scripts/checks/template-pack.ts",
    "check:deploy-boundary": "node scripts/checks/deploy-boundary.ts",
    "check:invocation-surface": "node scripts/checks/invocation-surface.ts",
    "check:webmcp": "node scripts/checks/webmcp.ts",
    "check:routing": "node scripts/checks/routing.ts",
    "check:local-first": "node --test test/local-first/*.test.mjs && node scripts/local-first-release/check.mjs",
    "check:offer-watch": "node scripts/checks/offer-watch.ts",
    "check:sandbox": "node scripts/checks/sandbox.ts",
    "check:sandbox:source": "node scripts/checks/sandbox.ts --source-only",
    "check:merge-agent": "node scripts/checks/merge-agent.ts",
    "merge-agent:run": "node scripts/merge-agent/main.ts",
    "setup": "agentic-os setup",
    "doctor": "agentic-os doctor",
    "lane": "agentic-os start",
    "land": "agentic-os land",
    "status": "agentic-os status",
    "reap": "agentic-os reap",
    "sync:canonical": "agentic-os canonical-sync",
    "queue:show": "agentic-os queue show",
    "check:evidence-contract": "node scripts/checks/evidence-contract.ts",
    "check:evidence": "node scripts/checks/evidence.ts",
    "check:authored-limits": "node scripts/checks/authored-limits.ts",
    "check:bundle-size": "node scripts/checks/bundle-size.ts",
    "check:task-bounds": "node scripts/validate-task-bounds.ts",
    "check:browser": "node scripts/checks/browser.ts",
    "check:named": "npm run check:terminology && npm run check:convergence && npm run check:take-rate && npm run check:template-pack && npm run check:deploy-boundary && npm run check:invocation-surface && npm run check:webmcp && npm run check:routing && npm run check:admission && npm run check:local-first && npm run check:offer-watch && npm run check:sandbox:source && npm run check:merge-agent && npm run check:authored-limits && npm run check:task-bounds -- --tasks=.kiro/specs/agentic-graph-commerce-platform/tasks.md --snapshot=config/task-bounds.snapshot.json && npm run check:browser",
    "check:implementation": "npm run types:check && npm run typecheck && npm run test && npm run test:workers && npm run check:named && npm run deploy:dev:dry && npm run deploy:production:dry",
    "check:adlc": "npm --prefix node_modules/agentic-os run evals",
    "check:integration": "node node_modules/agentic-os/bin/agentic-os-validation.mjs run",
    "check": "npm run check:integration && npm run check:evidence",
    "check:isolated-process": "node --test test/operational/isolated-process.test.ts",
    "build:local-host": "node scripts/local-host/build.ts",
    "start:local-host": "node node_modules/.cache/commerce-local-host/commerce-local-host.mjs",
    "check:local-host": "node --test test/operational/local-host.test.ts",
    "check:integration:source": "npm run check:adlc && npm run check:evidence-contract && npm run check:implementation",
    "check:plan": "node node_modules/agentic-os/bin/agentic-os-validation.mjs plan",
    "check:ci": "node node_modules/agentic-os/bin/agentic-os-validation.mjs ci",
    "check:integration:all": "node node_modules/agentic-os/bin/agentic-os-validation.mjs run --all --fresh",
    "build:durable-host": "node scripts/local-host/build.ts --listing",
    "start:durable-host": "node node_modules/.cache/commerce-listing-host/commerce-listing-host.mjs",
    "check:admission": "node --test test/admission/*.test.mjs"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.9",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260829.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.3.0",
    "agentic-os": "https://codeload.github.com/huijoohwee/agentic-os/tar.gz/047e7240b9cd31e7a78c708d998c02983144f0ea",
    "fast-check": "4.9.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "exports": {
    "./admission/worker-extension": "./src/admission/worker-extension.js",
    "./admission/commerce-admission-authority": "./src/admission/commerce-admission-authority.js",
    "./admission/commerce-admission-contract": "./src/admission/commerce-admission-contract.js",
    "./admission/commerce-admission-provider": "./src/admission/commerce-admission-provider.js",
    "./admission/commerce-deployment-identity": "./src/admission/commerce-deployment-identity.js",
    "./admission/commerce-release-proof": "./src/admission/commerce-release-proof.js",
    "./admission/durable-object-state-store": "./src/admission/durable-object-state-store.js",
    "./admission/agent-state": "./src/admission/agent-state.js",
    "./tests/admission/commerce-admission-auth": "./test/admission/commerce-admission-auth.test.mjs",
    "./tests/admission/commerce-admission-authority": "./test/admission/commerce-admission-authority.test.mjs",
    "./tests/admission/commerce-admission-contract-fixture": "./test/admission/commerce-admission-contract-fixture.test.mjs",
    "./tests/admission/commerce-admission-durability": "./test/admission/commerce-admission-durability.test.mjs",
    "./tests/admission/commerce-deployment-identity": "./test/admission/commerce-deployment-identity.test.mjs"
  }
}
