{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentic-commerce-edge-production",
  "main": "src/local-first/worker.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": { "directory": "./public/local-first", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "RELEASE_CANDIDATE_SHA": "local-unreleased" }
}
