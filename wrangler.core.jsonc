{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentic-commerce-core-local",
  "main": "src/core/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  },
  "durable_objects": {
    "bindings": [
      { "name": "AGENT_REGISTRY", "class_name": "AgentRegistry" },
      { "name": "INTENT_ROUTE", "class_name": "IntentRoute" },
      { "name": "CHECKOUT_SESSION", "class_name": "CheckoutSession" },
      { "name": "REVENUE_LEDGER", "class_name": "RevenueLedger" },
      { "name": "THEME_DEPLOYMENT", "class_name": "ThemeDeployment" },
      { "name": "AUTHORING_CLAIM", "class_name": "AuthoringClaim" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgentRegistry", "IntentRoute", "CheckoutSession"]
    },
    { "tag": "v2", "new_sqlite_classes": ["RevenueLedger"] },
    { "tag": "v3", "new_sqlite_classes": ["ThemeDeployment"] },
    { "tag": "v4" },
    { "tag": "v5", "new_sqlite_classes": ["AuthoringClaim"] }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "secrets": {
    "required": [
      "DISCOVERY_PROVIDER_BEARER_TOKEN",
      "ACOS_ADMISSION_AUTH_SECRET",
      "CHECKOUT_PROVIDER_AUTH_SECRET",
      "MARKETPLACE_PROVIDER_AUTH_SECRET"
    ]
  },
  "vars": {
    "DEPLOY_LANE": "Local",
    "RELEASE_CANDIDATE_SHA": "local-unreleased",
    "RELEASE_CANDIDATE_DIGEST": "local-unreleased-digest",
    "REGISTRY_ID": "primary",
    "AG_TAKE_RATE_BASIS_POINTS": "250",
    "AG_SELECTION_POLICY_JSON": "{\"schema\":\"agentic-graph-selection-policy/v1\",\"weights\":{\"price\":1,\"quality\":1,\"latency\":1},\"normalization\":\"min-max\"}",
    "ACOS_SOURCE_REVISION": "415e914da9e757387b992a5b03d89ac8855cb310",
    "ACOS_CATALOG_DIGEST": "2aa96c1240edb86579588408606af170abad243995cdd3b5ca77b91635c5f25b",
    "ACOS_ROUTING_SCHEMA": "agentic-canvas-os-docs-routing/v1",
    "ACOS_ROUTING_DIGEST": "cba48df57e4e825b2111fee720d81382714baec8e45e0e270f6e496e61a703b3",
    "ACOS_CATALOG_COUNTS_JSON": "{\"command\":142,\"semantic\":142,\"binding\":136}",
    "ACOS_REQUIRED_TOKENS_JSON": "[\"/tool.route\",\"#mcp\",\"@mcp-gateway\"]",
    "ACOS_RUNTIME_SOURCE_REVISION": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "ACOS_RUNTIME_CANDIDATE_DIGEST": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
    "DISCOVERY_PROVIDER_EVIDENCE_PIN_JSON": "{\"sourceRevision\":\"source-required\",\"receiptDigest\":\"receipt-required\",\"storageCompatibilityRevision\":\"storage-required\",\"providerVersionId\":\"provider-required\"}",
    "CHECKOUT_PROVIDER_EVIDENCE_PIN_JSON": "{\"sourceRevision\":\"source-required\",\"receiptDigest\":\"receipt-required\",\"storageCompatibilityRevision\":\"storage-required\",\"providerVersionId\":\"provider-required\"}",
    "MARKETPLACE_PROVIDER_EVIDENCE_PIN_JSON": "{\"sourceRevision\":\"source-required\",\"receiptDigest\":\"receipt-required\",\"storageCompatibilityRevision\":\"storage-required\",\"providerVersionId\":\"provider-required\"}"
  },
  "env": {
    "dev": {
      "name": "agentic-commerce-core-dev",
      "workers_dev": false,
