{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentic-commerce-sandbox",
  "main": "src/sandbox/executor.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  },
  "durable_objects": {
    "bindings": [
      { "name": "Sandbox", "class_name": "Sandbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Sandbox"] }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./config/sandbox.Dockerfile",
      "max_instances": 1,
      // Wrangler 4.127.1 defines lite as 256 MiB; isolation.ts uses the same ceiling.
      "instance_type": "lite"
    }
  ],
  "env": {
    "proof": {
      "name": "agentic-commerce-sandbox-proof",
      "workers_dev": true,
      "preview_urls": false,
      "secrets": {
        "required": ["SANDBOX_PROOF_BEARER_TOKEN"]
      },
      "vars": {
        "SANDBOX_PUBLIC_PROOF_ONLY": "true"
      },
      "durable_objects": {
        "bindings": [
          { "name": "Sandbox", "class_name": "Sandbox" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Sandbox"] }
      ],
      "containers": [
        {
          "class_name": "Sandbox",
          "image": "./config/sandbox.Dockerfile",
          "max_instances": 1,
          "instance_type": "lite"
        }
      ]
    },
    "dev": {
      "name": "agentic-commerce-sandbox-dev",
      "workers_dev": false,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [
          { "name": "Sandbox", "class_name": "Sandbox" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Sandbox"] }
      ],
      "containers": [
        {
          "class_name": "Sandbox",
          "image": "./config/sandbox.Dockerfile",
          "max_instances": 1,
          "instance_type": "lite"
        }
      ]
    }
  }
}
