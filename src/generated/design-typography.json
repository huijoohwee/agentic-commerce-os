":where([data-agentic-typography]) {\n  font: var(--agentic-font-size-body, 0.875rem)/var(--agentic-line-height-body, 1.25rem) var(--agentic-font-sans, -apple-system, BlinkMacSystemFont, Segoe UI, Noto Sans, Helvetica, Arial, sans-serif, Apple Color Emoji, Segoe UI Emoji);\n}\n.agentic-mono, .agentic-mono-detail, [data-agentic-typography] :where(dd, code, pre, samp, kbd, time) {\n  font-family: var(--agentic-font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace); font-variant-numeric: tabular-nums;\n}\n.agentic-text-detail, .agentic-mono-detail, [data-agentic-typography] :where(dd, code, pre, samp, kbd, time),\n.agentic-dashboard-eyebrow, .agentic-dashboard-description, .agentic-dashboard-detail {\n  font-size: .75rem; line-height: 1rem;\n}\n"
