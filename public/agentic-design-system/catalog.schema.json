{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-design-system/catalog.schema.json",
  "title": "Agentic Design System public catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "catalogId", "schemaVersion", "release", "requestedPath", "records"],
  "properties": {
    "$schema": { "const": "./catalog.schema.json" },
    "catalogId": { "const": "agentic-design-system" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status", "sourceRevision", "manifestDigest", "predecessor"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "released", "deprecated"] },
        "sourceRevision": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
        "manifestDigest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "predecessor": { "type": ["string", "null"] }
      }
    },
    "requestedPath": { "const": "/agentic-design-system/" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "canonicalKey", "name", "concern", "status", "summary", "owner", "source", "rights", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "canonicalKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*(?::[a-z0-9][a-z0-9.-]*)*$" },
          "name": { "type": "string", "minLength": 1 },
          "concern": { "enum": ["token", "brand-profile", "guideline", "accessibility", "component", "example"] },
          "status": { "const": "cleared" },
          "summary": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "revision", "path", "digest"],
            "properties": {
              "repository": { "type": "string", "minLength": 1 },
              "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
              "path": { "type": "string", "minLength": 1 },
              "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": ["license", "attribution", "permissionEvidence"],
            "properties": {
              "license": { "type": "string", "minLength": 1 },
              "attribution": { "type": "string", "minLength": 1 },
              "permissionEvidence": { "type": "string", "minLength": 1 }
            }
          },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "release": { "properties": { "status": { "const": "released" } } } } },
      "then": {
        "properties": {
          "release": {
            "properties": {
              "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
              "manifestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "release": { "properties": { "status": { "enum": ["draft", "deprecated"] } } } } },
      "then": { "properties": { "records": { "maxItems": 0 } } }
    }
  ]
}
